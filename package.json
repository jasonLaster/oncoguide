{
  "name": "oncoguide-content",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "check:content-consistency": "bun scripts/education-content-sync.ts verify",
    "plan:content-sync": "bun scripts/education-content-sync.ts plan",
    "sync:education-content": "bun scripts/education-content-sync.ts apply",
    "test:content-sync": "bun test ./scripts/education-content-sync.test.ts ./scripts/education-supplemental-artifacts.test.ts",
    "test:reader": "bun .renderer/node_modules/@playwright/test/cli.js test --config playwright.config.ts"
  }
}
